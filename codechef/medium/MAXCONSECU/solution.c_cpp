int findMaxConsecutiveOnes(vector<int>& nums) {
    int count=0;
    int final_count=0;
    for(int i=0;i<nums.size();i++){
        if(nums[i]==0){
            count=0;
        }
        else if(nums[i]==1){
            count++;
        }
        if (count>final_count){
            final_count=count;
        }
    }
    return final_count;
}
