#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here  
	int n,k;
	cin>>n>>k;
	int arr[n];
	for(int i = 0 ; i<n; i++){
	    cin>>arr[i];
	}
	bool found = false;
	for(int i = 0 ; i<n ; i++){
	    if(arr[i]==k){
	        found=true;
	    }
	}
	if(found){
	    cout<<"Yes"<<endl;
	}
	else{
	    cout<<"No"<<endl;
	}
}
