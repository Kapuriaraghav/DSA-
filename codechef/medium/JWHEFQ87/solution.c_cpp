#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    string num;
    cin>>num;
    for(int i=num.length()-1;i>=0;i--){
        if((num[i]-'0')%2!=0){
            cout<<num.substr(0,i+1)<<endl;
            return 0;
        }
    }
    cout<<"-1"<<endl;
    return 0;
}
