#include <bits/stdc++.h>
using namespace std;

int main() {
    string s1;
    char c1;
    int k;
    cin>>s1>>c1>>k;
    int count = 0 ; 
    bool answer=false;
    for(int i = 0 ; i<s1.length() ; i++){
        if(s1[i]==c1){
            count++;
        }
        if(count==k){
            answer=true;
            cout<<i<<endl;
            break;
        }
       
    }
    if(!answer){
        cout<<"-1"<<endl;
    }
}
