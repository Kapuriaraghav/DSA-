class Solution {
public:
    int missingNumber(vector<int>& nums) {
        long long n=nums.size();
        long long expected_sum=n*(n+1)/2;
        long long actual_sum=0;
        for(int i=0;i<n;i++){
            actual_sum=actual_sum+nums[i];
        }
        return expected_sum-actual_sum;
    }
};
