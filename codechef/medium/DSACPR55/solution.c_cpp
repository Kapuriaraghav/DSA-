#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n , m ;
    cin>>n>>m;
    int arr[n][m];
    for(int i = 0 ; i < n ;i++){
        for(int j = 0 ; j < m ; j++){
            cin>>arr[i][j];
        }
    }
    int T[m][n];
    for(int i = 0 ; i < n ; i ++){
        for(int j =0 ; j< m ; j++){
            T[j][i]=arr[i][j];
        }
    }
    for(int i = 0 ; i<m ; i++){
        for(int j = 0 ; j < n ; j++){
            cout<<T[i][j]<<" ";
        }
        cout<<endl;
}
}
