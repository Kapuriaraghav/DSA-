void rotateClockwise(vector<vector<int> > &matrix) {
    int n=matrix.size() ;
    // int a[n][n];
    // for(int i = 0 ; i < n ; i++){
    //     for(int j = 0 ; j < n ; j ++){
    //         cin>>a[i][j];
    //     }
    // }
    for(int i = 0 ; i<n ; i++){
        for(int j =i+1 ; j<n ;j++){
            swap(matrix[i][j],matrix[j][i]);
        }
    }
    for(int i = 0 ; i<n ;i++){
        for(int j = 0 ; j<n/2 ; j++){
            swap(matrix[i][j],matrix[i][n-1-j]);
        }
    }
    // for(int i = 0 ; i<n ; i++){
    //     for(int j = 0 ; j <n ; j++){
    //         cout<<a[i][j]<<" ";
    //     }
    //     cout<<endl;
    // }
}
