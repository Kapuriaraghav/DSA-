#include <stdio.h>

int main() {
	int n,m;
	scanf("%d %d",&n,&m);
	int a[n][m];
// 	int temp;
	int t[m][n];
	for(int i =0 ; i< n ; i++){
	    for(int j =0 ; j< m ; j++){
	        scanf("%d" ,&a[i][j]);
	        t[j][i]=a[i][j];
	    }
	}
