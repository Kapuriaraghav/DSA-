#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        string s;
        cin>>s;
        int current_depth=0;
        int max_depth=0;
        for(int i=0;i<s.length();i++){
            if(s[i]=='('){
                current_depth++;
                max_depth=max(max_depth,current_depth);
            }
            else if(s[i]==')'){
                current_depth--;
            }
        }
        cout<<max_depth<<endl;
    }
}
