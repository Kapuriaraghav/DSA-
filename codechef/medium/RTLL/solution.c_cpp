Node* listReverse(Node* head) {
    Node* next=head;
    Node* curr=head;
    Node* prev=NULL;
    
    while(curr!=NULL){
        next=curr->next;
        curr->next=prev;
        prev=curr;
        curr=next;
    }
    // 
    return prev;
}