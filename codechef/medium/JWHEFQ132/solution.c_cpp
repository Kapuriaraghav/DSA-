#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin>>n;
    int pairs[n][2];
    for(int i=0;i<n;i++){
        cin>>pairs[i][0]>>pairs[i][1];
    }
    int a,b;
    cin>>a>>b;
    bool found = false;
    for(int i = 0 ; i<n ; i++){
        if((pairs[i][0]==a && pairs[i][1]==b )|| (pairs[i][0]==b && pairs[i][1]==a)){
            found=true;
            break;
        }
    }
    if(found){
        cout<<"Yes"<<endl;
        
    }
    else{
        cout<<"No"<<endl;
    }
}
