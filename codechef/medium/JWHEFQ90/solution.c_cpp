#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        string x,y;
        cin>>x>>y;
        // your code goes here
        bool match=true;
        for(int i=0 ; i<x.length(); i++){
            if(x[i]!='?' && y[i]!='?' && x[i]!=y[i]){
                match=false;
            }
        }
        if(match==false){
            cout<<"NO"<<endl;
        }
        else{
            cout<<"YES"<<endl;
        }
    }

}
