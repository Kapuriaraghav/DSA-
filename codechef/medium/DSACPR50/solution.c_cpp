#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int arr[n];
        for(int i=0;i<n;i++){
            cin>>arr[i];
        }
        
        //  for(int i=0;i<n;i++){
        //     cout<<arr[i]<<" ";
        // }
        // cout<<endl;
    int sum=0;
    int end_sum=arr[0];
    
        for(int i=0;i<n;i++){
        sum = sum + arr[i];
         if(sum>end_sum){
            end_sum=sum;
            
        }
        if(sum<0){
            sum=0;
        }
        
        }
        
       
        
    
    cout<<end_sum<<endl;
    }
    return 0;
}
