#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
     int n;
     cin>>n;
     string s;
     cin>>s;
     int length;
     int count=0;
     length=s.length();
     for(int i=0;i<length;i++){
        if(s[i]==s[i+1]){
            count++;
        }
     }
     cout<<count<<endl;
     
    }
}
