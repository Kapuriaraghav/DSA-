#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int n,q;
cin>>n>>q;
int arr[n];

for(int i = 0 ; i<n ; i++){
    cin>>arr[i];
}
int answer=-1;
while(q--){
int left =0 ;
int right =n-1;
int target;
cin>>target;


while(left<=right){
    int middle=left+(right-left)/2;
    if(arr[middle]==target){
        answer=middle;
        break;
    }
    else if(arr[middle]>target){
        right = middle-1;
    }
    else{
        left=middle+1;
    }
}
    if(answer==-1){
        cout<<left<<endl;
    }
    else{
        cout<<answer<<endl;
    }
}
return 0;
}
